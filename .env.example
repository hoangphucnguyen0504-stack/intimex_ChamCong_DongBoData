NODE_ENV=production
PORT=3200
# HTTPS origin công khai hoặc http://localhost:3200 khi dùng SSH tunnel.
PUBLIC_ORIGIN=https://datadongbo.157.66.219.11.sslip.io
COOKIE_SECURE=true
ADMIN_USERNAME=admin
# Chạy npm run setup để tạo hash, khóa mã hóa và token; không dùng giá trị mẫu.
ADMIN_PASSWORD_HASH=
SESSION_SECRET=
API_TOKEN=
CONFIG_ENCRYPTION_KEY=
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=datadongbo
MYSQL_USER=datadongbo
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
MYSQL_SSL=false
MYSQL_POOL_SIZE=6
# Tối đa 40 lượt đọc/ghi Sheets/phút do một worker điều phối.
SHEETS_REQUESTS_PER_MINUTE=40

# Khởi tạo cấu hình Google trong MySQL lần đầu; không ghi đè cấu hình đã lưu trên UI.
GOOGLE_SHEET_ID=
# JSON Service Account trên một dòng, bọc dấu nháy đơn; không commit khóa thật.
GOOGLE_SERVICE_ACCOUNT_JSON=
SYNC_INTERVAL_MINUTES=60
SYNC_BATCH_SIZE=100
# Bật sau khi đã nhập/đối chiếu dữ liệu và chuyển nguồn dữ liệu chấm công.
SYNC_ENABLED=false
# Danh sách tài nguyên/cột có sẵn; chỉ tạo cấu hình còn thiếu, chưa chạy import.
BOOTSTRAP_ENTITIES_FILE=./config/cham-cong-entities.json
# Tên Docker network của Caddy/HDoi đang chạy trên VPS.
CADDY_DOCKER_NETWORK=hdoi_default
CHATBOX_READ_TOKEN=
KINHDOANH_READ_TOKEN=
# API hệ thống Sản Xuất / Kinh Doanh
SANXUAT_API_URL=https://intimexkd-api.vercel.app
KINHDOANH_API_URL=https://intimexkd-api.vercel.app
