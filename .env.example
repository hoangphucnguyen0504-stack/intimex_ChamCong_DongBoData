NODE_ENV=production
PORT=3200
# HTTPS origin công khai hoặc http://localhost:3200 khi dùng SSH tunnel.
PUBLIC_ORIGIN=http://localhost:3200
COOKIE_SECURE=false
ADMIN_USERNAME=admin
# Chạy npm run setup để tạo hash, khóa mã hóa và token; không dùng giá trị mẫu.
ADMIN_PASSWORD_HASH=
SESSION_SECRET=
API_TOKEN=
CONFIG_ENCRYPTION_KEY=
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=datadongbo
MYSQL_USER=datadongbo
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
MYSQL_SSL=false
MYSQL_POOL_SIZE=6
# Tối đa 40 lượt đọc/ghi Sheets/phút do một worker điều phối.
SHEETS_REQUESTS_PER_MINUTE=40
